# Copy to /opt/ourmemory/ourmemory.env and chmod 600.
# Public origin used by cookies, links and subdomain routing.
OM_BASE_HOST=om.autozteam.cn
OM_BASE_URL=https://om.autozteam.cn

# 32 random bytes, hex or base64. Generate with:
#   openssl rand -hex 32
# If omitted, the server creates data/master.key on first start.
OM_MASTER_KEY=

# Shared archive ceiling for this host. The first deployment uses 5 GiB.
OM_SHARED_MAX_BYTES=5368709120
OM_CACHE_BYTES=10737418240
OM_MAX_UPLOAD=8589934592
OM_DEFAULT_PRIVATE_QUOTA=1073741824

# Secret required to register a storage-contributor node.
OM_NODE_SECRET=

# SkyMail (Cloud Mail) sender. OM_DEBUG=1 prints verification codes to the
# journal when mail is not configured; set it to 0 in production.
OM_SKYMAIL_BASE=https://skymail.ink
OM_SKYMAIL_EMAIL=
OM_SKYMAIL_PASSWORD=
OM_SKYMAIL_ACCOUNT_ID=
OM_DEBUG=0

# OpenList bootstrap. The admin account is only created on an empty database.
OPENLIST_ADMIN_PASSWORD=
OPENLIST_SITE_URL=https://om.autozteam.cn
